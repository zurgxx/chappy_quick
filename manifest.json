{
  "manifest_version": 3,
  "name": "Chappy Quick",
  "version": "0.2.0",
  "description": "ChatGPT Webに定型文のクイック送信ボタンを追加します。",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
